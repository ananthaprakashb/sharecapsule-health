{
  "name": "sharecapsule-health",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b --pretty false",
    "android:prepare": "npm run build && node scripts/android/prepare.mjs",
    "android:open": "npm run android:prepare && npx cap open android",
    "android:run": "npm run android:prepare && npx cap run android"
  },
  "dependencies": {
    "@capacitor/core": "8.5.1",
    "@vitejs/plugin-react": "latest",
    "vite": "latest",
    "typescript": "latest",
    "react": "latest",
    "react-dom": "latest"
  },
  "devDependencies": {
    "@capacitor/android": "8.5.1",
    "@capacitor/assets": "3.0.5",
    "@capacitor/cli": "8.5.1",
    "@types/react": "latest",
    "@types/react-dom": "latest"
  }
}
